# Path to OAuth client JSON downloaded from Google Cloud Console (Desktop app).
YT_CLIENT_JSON=auth/google-client.json

# Refresh token from `npm run auth:youtube` (never commit).
YT_REFRESH_TOKEN=

# @SurviveOrion channel id
YT_CHANNEL_ID=UCJKMXg2yatBgDZv5XrnPO8A

# Instagram Business account id from auth script.
IG_USER_ID=

# Long-lived page-scoped token (~60 day rotation; auth script prints expiry).
IG_ACCESS_TOKEN=

# Upload privacy for YouTube test runs (private first, then public).
DEFAULT_PRIVACY=public
