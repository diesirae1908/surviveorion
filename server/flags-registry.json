{
  "schema": 1,
  "capsSince": {
    "overdrive": {
      "forms.starshell": 2,
      "forms.arc": 2,
      "forms.autocannon": 2,
      "forms.meteors": 2,
      "forms.razor": 2,
      "forms.thunder": 2,
      "forms.cloak": 2,
      "forms.flare": 2,
      "forms.ion": 2,
      "forms.howlers": 2,
      "forms.vortex": 2,
      "alwaysHotScale": 2
    }
  },
  "flags": {
    "overdrive": {
      "kind": "gameplay",
      "area": "gameplay",
      "description": "Grazes charge the hull. Full charge = HOT (held until no drone is in the graze band, max 3 s, when armWhenClear is on): the next orb fires its Overdrive form. Loose drones near a HOT ship speed up.",
      "default": {
        "enabled": false,
        "params": {
          "chargePerGraze": 0.15,
          "razorClearance": 0.25,
          "razorGrazeScale": 2,
          "outerClearance": 0.75,
          "outerGrazeScale": 0.5,
          "chargePerKill": 0.02,
          "maxKillChargePerSec": 0.1,
          "killChargeLockout": 4,
          "drainDelay": 3,
          "drainPerSec": 0.05,
          "hotDroneSpeedScale": 1.2,
          "armWhenClear": true,
          "hotRadius": 3,
          "hotMaxSeconds": 8,
          "burstRadius": 1.2,
          "mutatorHooks": true,
          "forms": {
            "pulse": { "on": true, "fanCount": 3, "fanSpreadDeg": 12 },
            "shield": { "on": true, "radiusScale": 1.3, "refund": 0.5 },
            "freeze": { "on": true, "radiusScale": 1.25, "chainRadius": 1.2, "chainMax": 12 },
            "magnet": { "on": true, "maxPull": 3 },
            "shockwave": { "on": true, "echoDelay": 0.6, "echoScale": 0.8 },
            "missiles": { "on": true, "count": 12, "maxAlive": 18 },
            "starshell": { "on": false, "durationScale": 1.5, "perKillExtend": 0.15, "maxExtend": 3 },
            "arc": { "on": false, "radiusScale": 1.4 },
            "autocannon": { "on": false, "barrels": 2 },
            "meteors": { "on": false, "durationScale": 2 },
            "razor": { "on": false, "durationScale": 1.5, "orbitScale": 1.25 },
            "thunder": { "on": false, "widthScale": 1.5, "hopRadiusScale": 1.3 },
            "cloak": { "on": false, "durationScale": 1.4, "bombRadiusScale": 1.3 },
            "flare": { "on": false, "lifetimeScale": 1.5 },
            "ion": { "on": false, "radiusScale": 1.3 },
            "howlers": { "on": false, "radiusScale": 1.3, "durationScale": 1.3 },
            "vortex": { "on": false, "killRadiusScale": 1.3 }
          },
          "alwaysHotScale": 1
        }
      },
      "bounds": {
        "chargePerGraze": [0.01, 0.5],
        "razorClearance": [0, 1],
        "razorGrazeScale": [1, 4],
        "outerClearance": [0, 1],
        "outerGrazeScale": [0, 1],
        "chargePerKill": [0, 0.1],
        "maxKillChargePerSec": [0, 0.5],
        "killChargeLockout": [0, 10],
        "drainDelay": [0, 10],
        "drainPerSec": [0, 1],
        "hotDroneSpeedScale": [1, 1.5],
        "hotRadius": [0, 8],
        "hotMaxSeconds": [0, 60],
        "burstRadius": [0, 3],
        "forms.pulse.fanCount": [1, 5],
        "forms.pulse.fanSpreadDeg": [0, 30],
        "forms.shield.radiusScale": [1, 2],
        "forms.shield.refund": [0, 1],
        "forms.freeze.radiusScale": [1, 2],
        "forms.freeze.chainRadius": [0, 3],
        "forms.freeze.chainMax": [0, 40],
        "forms.magnet.maxPull": [1, 6],
        "forms.shockwave.echoDelay": [0.2, 2],
        "forms.shockwave.echoScale": [0.3, 1],
        "forms.missiles.count": [6, 18],
        "forms.missiles.maxAlive": [12, 24],
        "forms.starshell.durationScale": [1, 2],
        "forms.starshell.perKillExtend": [0, 0.5],
        "forms.starshell.maxExtend": [0, 6],
        "forms.arc.radiusScale": [1, 2],
        "forms.autocannon.barrels": [1, 3],
        "forms.meteors.durationScale": [1, 3],
        "forms.razor.durationScale": [1, 2],
        "forms.razor.orbitScale": [1, 1.6],
        "forms.thunder.widthScale": [1, 2],
        "forms.thunder.hopRadiusScale": [1, 2],
        "forms.cloak.durationScale": [1, 2],
        "forms.cloak.bombRadiusScale": [1, 1.6],
        "forms.flare.lifetimeScale": [1, 2.5],
        "forms.ion.radiusScale": [1, 1.8],
        "forms.howlers.radiusScale": [1, 2],
        "forms.howlers.durationScale": [1, 2],
        "forms.vortex.killRadiusScale": [1, 2],
        "alwaysHotScale": [1, 1.5]
      }
    },
    "ui.overdriveFx": {
      "kind": "client",
      "area": "ui.overdriveFx",
      "description": "OVERDRIVE presentation: hull heat tint, form popup, audio stings.",
      "default": {
        "enabled": false,
        "params": { "heatTint": true, "formPopup": true, "stings": true }
      },
      "bounds": {}
    },
    "ui.hud": {
      "kind": "client",
      "area": "ui.hud",
      "description": "Rising Gold in-run HUD: chain bar, kill pops, danger vignette, touch stick fade.",
      "default": {
        "enabled": false,
        "params": {
          "chainBar": true,
          "pops": true,
          "vignette": true,
          "stickFade": true,
          "killPopMinChain": 5,
          "vignetteMaxAlpha": 0.35,
          "edgeRadar": false,
          "hitStop": false,
          "hitStopShieldMs": 60,
          "sky": false,
          "paceChip": false
        }
      },
      "bounds": { "killPopMinChain": [1, 20], "vignetteMaxAlpha": [0, 0.6], "hitStopShieldMs": [0, 150] }
    },
    "ui.result": {
      "kind": "client",
      "area": "ui.result",
      "description": "Rising Gold death moment and result screen v2.",
      "default": {
        "enabled": false,
        "params": { "deathMoment": true, "resultV2": true, "freezeMs": 120, "shareV2": false, "stories": false }
      },
      "bounds": { "freezeMs": [0, 300] }
    },
    "ui.lobby": {
      "kind": "client",
      "area": "ui.lobby",
      "description": "Web lobby v3: hero, board podium, flight log, bottom tab bar, mission briefing and pilot dossier. Web only, never in the App Store play view.",
      "default": {
        "enabled": false,
        "params": { "tabBar": true, "briefing": true, "pilotTab": true }
      },
      "bounds": {}
    },
    "ui.challenge": {
      "kind": "client",
      "area": "ui.challenge",
      "description": "Challenge links: a pilot shares /c/<code> for today's patrol. Friends land on today's patrol with that score as the pace target, see win or lose on the result and can send theirs back. Web only. Off: links open the normal game with the normal preview, no banner, no target, no new links.",
      "default": {
        "enabled": false,
        "params": {
          "mint": true,
          "lobbyBanner": true,
          "paceTarget": true,
          "resultLine": true,
          "challengeBack": true,
          "ogMeta": true
        }
      },
      "bounds": {}
    },
    "orders": {
      "kind": "gameplay",
      "area": "meta",
      "description": "Daily Orders and the Pilot Ladder: three orders per patrol day earn Merit. Server credited, cosmetic rewards only, never part of the ruleset.",
      "default": {
        "enabled": false,
        "params": {
          "meritEasy": 1,
          "meritMedium": 2,
          "meritHard": 4,
          "pool": {
            "survive-30": { "on": true, "target": 30 },
            "graze-15": { "on": true, "target": 15 },
            "kills-25": { "on": true, "target": 25 },
            "chain-5": { "on": true, "target": 5 },
            "graze-40": { "on": true, "target": 40 },
            "survive-60": { "on": true, "target": 60 },
            "hot-2": { "on": true, "target": 2 },
            "survive-120": { "on": true, "target": 120 },
            "chain-9": { "on": true, "target": 9 },
            "kills-250": { "on": true, "target": 250 },
            "fires-4": { "on": true, "target": 4 }
          }
        }
      },
      "bounds": {
        "meritEasy": [0, 5],
        "meritMedium": [0, 10],
        "meritHard": [0, 20],
        "pool.survive-30.target": [15, 60],
        "pool.graze-15.target": [5, 40],
        "pool.kills-25.target": [10, 80],
        "pool.chain-5.target": [3, 8],
        "pool.graze-40.target": [20, 100],
        "pool.survive-60.target": [40, 120],
        "pool.hot-2.target": [1, 5],
        "pool.survive-120.target": [80, 300],
        "pool.chain-9.target": [6, 10],
        "pool.kills-250.target": [120, 600],
        "pool.fires-4.target": [2, 10]
      }
    },
    "app.shell": {
      "kind": "client",
      "area": "app.shell",
      "description": "App Store build boots into the web lobby v3 (needs ui.lobby on and a build with shell protocol >= minShell). Off: native SwiftUI Home. Params AND-combine with ui.lobby params. Never reachable on the website.",
      "default": {
        "enabled": false,
        "params": { "minShell": 1, "briefing": true, "pilotTab": true, "stories": true }
      },
      "bounds": { "minShell": [1, 99] }
    },
    "app.review": {
      "kind": "client",
      "area": "app.review",
      "description": "Allows the App Store rating prompt in the app after a good run (medal or personal best, calm moment, once per app version). Off: never asked.",
      "default": {
        "enabled": false,
        "params": { "minSessions": 3, "minRunSeconds": 30, "onMedal": true, "onPersonalBest": true }
      },
      "bounds": { "minSessions": [2, 20], "minRunSeconds": [30, 300] }
    }
  }
}
