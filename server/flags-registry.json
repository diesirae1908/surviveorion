{
  "schema": 1,
  "flags": {
    "overdrive": {
      "kind": "gameplay",
      "area": "gameplay",
      "description": "Grazes charge the hull. Full charge = HOT (held until no drone is in the graze band, max 3 s, when armWhenClear is on): the next orb fires its Overdrive form. Loose drones near a HOT ship speed up.",
      "default": {
        "enabled": false,
        "params": {
          "chargePerGraze": 0.15,
          "razorClearance": 0.25,
          "razorGrazeScale": 2,
          "outerClearance": 0.75,
          "outerGrazeScale": 0.5,
          "chargePerKill": 0.02,
          "maxKillChargePerSec": 0.1,
          "killChargeLockout": 4,
          "drainDelay": 3,
          "drainPerSec": 0.05,
          "hotDroneSpeedScale": 1.2,
          "armWhenClear": true,
          "hotRadius": 3,
          "hotMaxSeconds": 8,
          "burstRadius": 1.2,
          "mutatorHooks": true,
          "forms": {
            "pulse": { "on": true, "fanCount": 3, "fanSpreadDeg": 12 },
            "shield": { "on": true, "radiusScale": 1.3, "refund": 0.5 },
            "freeze": { "on": true, "radiusScale": 1.25, "chainRadius": 1.2, "chainMax": 12 },
            "magnet": { "on": true, "maxPull": 3 },
            "shockwave": { "on": true, "echoDelay": 0.6, "echoScale": 0.8 },
            "missiles": { "on": true, "count": 12, "maxAlive": 18 }
          }
        }
      },
      "bounds": {
        "chargePerGraze": [0.01, 0.5],
        "razorClearance": [0, 1],
        "razorGrazeScale": [1, 4],
        "outerClearance": [0, 1],
        "outerGrazeScale": [0, 1],
        "chargePerKill": [0, 0.1],
        "maxKillChargePerSec": [0, 0.5],
        "killChargeLockout": [0, 10],
        "drainDelay": [0, 10],
        "drainPerSec": [0, 1],
        "hotDroneSpeedScale": [1, 1.5],
        "hotRadius": [0, 8],
        "hotMaxSeconds": [0, 60],
        "burstRadius": [0, 3],
        "forms.pulse.fanCount": [1, 5],
        "forms.pulse.fanSpreadDeg": [0, 30],
        "forms.shield.radiusScale": [1, 2],
        "forms.shield.refund": [0, 1],
        "forms.freeze.radiusScale": [1, 2],
        "forms.freeze.chainRadius": [0, 3],
        "forms.freeze.chainMax": [0, 40],
        "forms.magnet.maxPull": [1, 6],
        "forms.shockwave.echoDelay": [0.2, 2],
        "forms.shockwave.echoScale": [0.3, 1],
        "forms.missiles.count": [6, 18],
        "forms.missiles.maxAlive": [12, 24]
      }
    },
    "ui.overdriveFx": {
      "kind": "client",
      "area": "ui.overdriveFx",
      "description": "OVERDRIVE presentation: hull heat tint, form popup, audio stings.",
      "default": {
        "enabled": false,
        "params": { "heatTint": true, "formPopup": true, "stings": true }
      },
      "bounds": {}
    },
    "ui.hud": {
      "kind": "client",
      "area": "ui.hud",
      "description": "Rising Gold in-run HUD: chain bar, kill pops, danger vignette, touch stick fade.",
      "default": {
        "enabled": false,
        "params": {
          "chainBar": true,
          "pops": true,
          "vignette": true,
          "stickFade": true,
          "killPopMinChain": 5,
          "vignetteMaxAlpha": 0.35
        }
      },
      "bounds": { "killPopMinChain": [1, 20], "vignetteMaxAlpha": [0, 0.6] }
    },
    "ui.result": {
      "kind": "client",
      "area": "ui.result",
      "description": "Rising Gold death moment and result screen v2.",
      "default": {
        "enabled": false,
        "params": { "deathMoment": true, "resultV2": true, "freezeMs": 120 }
      },
      "bounds": { "freezeMs": [0, 300] }
    }
  }
}
