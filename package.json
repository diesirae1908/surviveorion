{
  "name": "orion-web",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "server": "node server/index.mjs",
    "start": "ORION_SERVE_DIST=1 node server/index.mjs",
    "sim-test": "npx tsx scripts/sim-test.ts",
    "test:nickname": "npx tsx scripts/test-nickname.ts",
    "test:touch-input": "npx tsx scripts/test-touch-input.ts",
    "test:gameover-rank": "npx tsx scripts/test-gameover-rank.ts",
    "test:crash-filter": "npx tsx scripts/test-crash-filter.ts",
    "test:highlights": "npx tsx scripts/test-highlights.ts",
    "test:clip-sidecar": "npx tsx scripts/test-clip-sidecar.ts",
    "test:recorder": "npx tsx scripts/test-recorder.ts",
    "test:daily-history": "npx tsx scripts/test-daily-history.ts",
    "test:server-daily-history": "node scripts/test-server-daily-history.mjs",
    "test:serve-static": "node scripts/test-serve-static.mjs",
    "test:clip-inbox": "node scripts/test-clip-inbox.mjs",
    "test:notion-clips": "node scripts/test-notion-clips.mjs",
    "test:daily-combined-rank": "node scripts/test-daily-combined-rank.mjs",
    "test:daily-bots": "node scripts/test-daily-bots.mjs",
    "test:rehearsal-day": "npx tsx scripts/test-rehearsal-day.ts",
    "test:patrol-date": "npx tsx scripts/test-patrol-date.ts",
    "test:no-em-dash": "npx tsx scripts/test-no-em-dash.ts",
    "test:mutators": "npx tsx scripts/test-mutators.ts",
    "test:cors-origins": "node scripts/test-cors-origins.mjs",
    "test:account-delete": "node scripts/test-account-delete.mjs",
    "cap:sync": "npm run build && npx cap sync ios",
    "ios:open": "npx cap open ios",
    "test": "npm run test:nickname && npm run test:touch-input && npm run test:gameover-rank && npm run test:crash-filter && npm run test:highlights && npm run test:clip-sidecar && npm run test:recorder && npm run test:daily-history && npm run test:server-daily-history && npm run test:serve-static && npm run test:clip-inbox && npm run test:notion-clips && npm run test:daily-combined-rank && npm run test:no-em-dash && npm run test:mutators && npm run test:cors-origins && npm run test:account-delete"
  },
  "devDependencies": {
    "typescript": "^7.0.2",
    "vite": "^8.1.4"
  },
  "dependencies": {
    "@capacitor/app": "^8.1.1",
    "@capacitor/cli": "^8.5.1",
    "@capacitor/core": "^8.5.1",
    "@capacitor/filesystem": "^8.1.3",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/ios": "^8.5.1",
    "@capacitor/local-notifications": "^8.3.1",
    "@capacitor/share": "^8.0.1",
    "@capacitor/status-bar": "^8.0.3"
  }
}
