{
  "name": "orion-web",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "server": "node server/index.mjs",
    "start": "ORION_SERVE_DIST=1 node server/index.mjs",
    "sim-test": "npx tsx scripts/sim-test.ts",
    "test:nickname": "npx tsx scripts/test-nickname.ts",
    "test:touch-input": "npx tsx scripts/test-touch-input.ts",
    "test:gameover-rank": "npx tsx scripts/test-gameover-rank.ts",
    "test:crash-filter": "npx tsx scripts/test-crash-filter.ts",
    "test:highlights": "npx tsx scripts/test-highlights.ts",
    "test:recorder": "npx tsx scripts/test-recorder.ts",
    "test:daily-history": "npx tsx scripts/test-daily-history.ts",
    "test:server-daily-history": "node scripts/test-server-daily-history.mjs",
    "test:daily-combined-rank": "node scripts/test-daily-combined-rank.mjs",
    "test:no-em-dash": "npx tsx scripts/test-no-em-dash.ts",
    "test": "npm run test:nickname && npm run test:touch-input && npm run test:gameover-rank && npm run test:crash-filter && npm run test:highlights && npm run test:recorder && npm run test:daily-history && npm run test:server-daily-history && npm run test:daily-combined-rank && npm run test:no-em-dash"
  },
  "devDependencies": {
    "typescript": "^7.0.2",
    "vite": "^8.1.4"
  }
}
